# Copy to .env (repository root) and adjust. Never commit real secrets: .env is git-ignored.
# Relative paths are resolved from the repository root.

# REQUIRED before adding AI providers: 32-byte master key (base64) that encrypts provider API keys.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: losing it makes every stored provider key unreadable.
PLATFORM_MASTER_KEY=
DATABASE_URL=pglite://./data/pgdata
PLATFORM_DATA_DIR=./data
PLATFORM_STORAGE_ROOT=./data/storage
HOST=127.0.0.1
PORT=8787
COOKIE_SECURE=false
LOG_LEVEL=info
# Extra browser origins (comma separated) allowed to change data, e.g. https://platform.example.com
# Same-origin and loopback (localhost/127.0.0.1) pages are always allowed.
ALLOWED_ORIGINS=
AGENT_LIBRARY_DIR=./agent-library
# In-process scheduler worker that executes ready workflow tasks.
WORKER_ENABLED=true
WORKER_IDLE_MS=2000
